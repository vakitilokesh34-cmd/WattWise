# ─────────────────────────────────────────────────────────────
# WattWise — Frontend environment
# Copy to `.env` (dev) or `.env.production` (build) and adjust.
# Only VITE_* variables are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────

# Base URL of the WattWise backend API.
# Leave as `/api` to use the Vite dev proxy (see VITE_PROXY_TARGET).
VITE_API_BASE_URL=/api

# Backend origin used by the Vite dev-server proxy for /api requests.
VITE_PROXY_TARGET=http://localhost:8000

# Request timeout in milliseconds.
VITE_API_TIMEOUT=20000

# Transport mode:
#   live  -> always call the real backend
#   mock  -> always use the built-in isolated mock layer
#   auto  -> try the backend, transparently fall back to mock if unavailable
VITE_API_MODE=auto

# Set to "false" to disable the mock layer entirely (hard fail on backend outage).
VITE_ENABLE_MOCK_FALLBACK=true

# ── Realtime ────────────────────────────────────────────────
# master switch
VITE_ENABLE_REALTIME=true
# transport: sse | polling | off
VITE_REALTIME_TRANSPORT=sse
VITE_REALTIME_SSE_PATH=/api/realtime/stream
VITE_REALTIME_POLL_MS=30000

# ── Uploads ──────────────────────────────────────────────────
# max client-side file size for CSV uploads, in megabytes
VITE_UPLOAD_MAX_MB=25
VITE_UPLOAD_ACCEPT=.csv,text/csv

# ── 3D scene ─────────────────────────────────────────────────
# high | medium | low — overrides device auto-detection when set
VITE_SCENE_QUALITY=auto
# hard cap on simultaneously rendered energy particles
VITE_MAX_PARTICLES=260

# ── Feature flags ────────────────────────────────────────────
VITE_ENABLE_3D=true
VITE_ENABLE_ANIMATIONS=true
